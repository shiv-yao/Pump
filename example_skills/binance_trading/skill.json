{
  "name": "binance_trading",
  "description": "Binance 合約交易 skill - 整合 AI Agent 交易系統",
  "version": "1.0.0",
  "enabled": true,
  "tools": [
    {
      "name": "get_market_data",
      "description": "取得幣種市場數據，包含價格、漲跌、成交量",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string", "description": "幣種如 BTCUSDT" }
        },
        "required": ["symbol"]
      }
    },
    {
      "name": "analyze_trade_signal",
      "description": "分析指定幣種的交易信號，判斷做多/做空/觀望",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string", "description": "幣種如 BTCUSDT" },
          "timeframe": { "type": "string", "description": "時間框架 1h/4h/1d", "default": "1h" }
        },
        "required": ["symbol"]
      }
    },
    {
      "name": "get_top_movers",
      "description": "取得24小時漲跌幅最大的幣種排行",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "description": "回傳數量", "default": 5 },
          "direction": { "type": "string", "description": "gainers 或 losers", "default": "gainers" }
        }
      }
    }
  ]
}
