{
  "id": "fund_brain",
  "name": "fund_brain",
  "description": "Unified fund brain wrapper for engine control, state access, and high-level trading orchestration",
  "version": "1.0.0",
  "enabled": true,
  "category": "brain",
  "price": 0,
  "author": "system",
  "tools": [
    {
      "name": "start_engine",
      "description": "Start the main fund trading engine",
      "input_schema": {
        "type": "object",
        "properties": {
          "markets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Markets to trade, e.g. [\"BTCUSDT\", \"ETHUSDT\"]"
          },
          "capital": {
            "type": "number",
            "description": "Capital allocated to the engine"
          }
        }
      }
    },
    {
      "name": "stop_engine",
      "description": "Stop the main fund trading engine",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_state",
      "description": "Get current fund engine state",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "run_fund_cycle",
      "description": "Run one high-level fund decision cycle",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Target symbol, e.g. BTCUSDT"
          },
          "capital": {
            "type": "number",
            "description": "Optional capital reference for allocation"
          }
        }
      }
    },
    {
      "name": "fund_decide_trade",
      "description": "Generate a fund-level decision using alpha, regime, sizing, and risk",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Target symbol"
          },
          "capital": {
            "type": "number",
            "description": "Optional capital reference"
          }
        }
      }
    }
  ]
}
