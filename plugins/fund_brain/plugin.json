{
  "id": "fund_brain",
  "name": "Fund Brain PRO+",
  "description": "Central fund-level brain that fuses alpha, allocator, strategy manager, and risk engine to control trading decisions and execution",
  "version": "3.0.0",
  "enabled": true,
  "category": "brain",
  "price": 0,
  "author": "system",
  "tools": [
    {
      "name": "start_engine",
      "description": "Start trading engine through fund brain",
      "input_schema": {
        "type": "object",
        "properties": {
          "markets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "capital": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "stop_engine",
      "description": "Stop trading engine",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_state",
      "description": "Get engine state",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "fund_decide_trade",
      "description": "Generate fund-level decision using alpha fusion, allocator, strategy manager, and risk control",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "capital": { "type": "number" }
        },
        "required": ["symbol"]
      }
    },
    {
      "name": "run_fund_cycle",
      "description": "Run a full fund cycle: decide → execute",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "capital": { "type": "number" }
        },
        "required": ["symbol"]
      }
    }
  ]
}
