{
  "id": "polymarket_alpha",
  "name": "polymarket_alpha",
  "description": "Polymarket orderbook alpha via WebSocket + REST fallback",
  "version": "1.0.0",
  "enabled": true,
  "category": "alpha",
  "price": 0,
  "author": "system",
  "tools": [
    {
      "name": "start_polymarket_book",
      "description": "Start Polymarket market-channel orderbook stream",
      "input_schema": {
        "type": "object",
        "properties": {
          "asset_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["asset_ids"]
      }
    },
    {
      "name": "stop_polymarket_book",
      "description": "Stop Polymarket market-channel orderbook stream",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_polymarket_signal",
      "description": "Compute trading signal from cached orderbook and external probability",
      "input_schema": {
        "type": "object",
        "properties": {
          "asset_id": { "type": "string" },
          "symbol": { "type": "string" }
        },
        "required": ["asset_id", "symbol"]
      }
    }
  ]
}
