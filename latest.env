# =========================
# CORE
# =========================
TRADING_API_BASE=https://your-gateway-url/api
POLYMARKET_API_KEY=

ENABLE_OPENAI=false
OPENAI_API_KEY=
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=

DATABASE_URL=

# =========================
# EXECUTION GATEWAY
# =========================
GATEWAY_TIMEOUT=5
GATEWAY_RETRY=2

# =========================
# EXECUTION ENGINE (低延遲核心)
# =========================
ENGINE_LOOP_INTERVAL=0.15
MAX_LATENCY=0.10

MIN_EDGE=0.02
EDGE_STRONG_THRESHOLD=0.05
FILL_PROB_THRESHOLD=0.30

EXECUTION_MODE=adaptive
EXECUTION_RETRY=2
EXECUTION_TIMEOUT=3

# =========================
# FUND BRAIN PRO+
# =========================
FB_THRESHOLD_MIN=0.50
FB_THRESHOLD_MAX=0.70

FB_RISK_MIN=0.50
FB_RISK_MAX=2.00

FB_BASE_SIZE=0.01

FB_ENABLE_DYNAMIC_SIZING=true
FB_ENABLE_REGIME_FILTER=true

# ===== sniper override =====
FB_ENABLE_SNIPER_OVERRIDE=true
FB_SNIPER_PRIORITY=1.0

# =========================
# PORTFOLIO
# =========================
REGIME_TREND_THRESHOLD=0.60

ALPHA_ORDERBOOK_WEIGHT=0.40
ALPHA_WALLET_WEIGHT=0.30
ALPHA_EVENT_WEIGHT=0.20
ALPHA_FLOW_WEIGHT=0.10

ALLOCATOR_RISK_FACTOR=1.2
PORTFOLIO_MAX_STRATEGIES=5
PORTFOLIO_REBALANCE_INTERVAL=60

# =========================
# STRATEGY CONTROL
# =========================
STRATEGY_MIN_TRADES=20
STRATEGY_SHUTDOWN_DD=0.20

# =========================
# RISK MANAGEMENT
# =========================
MAX_POSITION_PER_TRADE=0.05
MAX_TOTAL_EXPOSURE=0.25
MAX_DAILY_LOSS=0.15

ENABLE_KILL_SWITCH=true
KILL_SWITCH_DD=0.25

# =========================
# WALLET ALPHA（早期判斷核心）
# =========================
WALLET_ALPHA_WINDOW=50
WALLET_DECAY=0.95

WALLET_MIN_CONFIDENCE=0.6
WALLET_CLUSTER_ENABLE=true

# 🔥 強化 insider detection
WALLET_EARLY_SCORE=0.75
WALLET_STRONG_SCORE=0.85

# =========================
# SNIPER MAX（🔥核心）
# =========================
SNIPER_ENABLE=true

SNIPER_SCAN_INTERVAL=0.25
SNIPER_MIN_SCORE=0.7
SNIPER_STRONG_SCORE=0.85

SNIPER_BASE_SIZE=0.02
SNIPER_MAX_SIZE=0.06

# ===== early entry（關鍵）=====
EARLY_WALLET_MIN=0.60
EARLY_RUG_MAX=0.70
EARLY_ENTRY_FRAC=0.005
EARLY_ADDON_FRAC=0.015
EARLY_MAX_IMPACT=0.15
EARLY_MIN_LIQ=300

# ===== dev wallet sniper（最強）=====
DEV_WALLET_ENABLE=true
DEV_WALLET_SCORE=0.80
DEV_WALLET_SIZE=0.05

# =========================
# MEMPOOL SNIPER（🔥極限提前）
# =========================
ENABLE_MEMPOOL=true
MEMPOOL_SCAN_INTERVAL=0.1
MEMPOOL_MIN_SCORE=0.75

# =========================
# PUMP.FUN
# =========================
PUMP_ENABLE=true
PUMP_MAX_AGE_SEC=120
PUMP_LIMIT=20

# =========================
# RUG GUARD（🔥必開）
# =========================
RUG_SCORE_MAX=0.70
RUG_LIQ_MIN=300

# =========================
# LEDGER
# =========================
FEE_RATE=0.0007
LEDGER_ENABLE=true
EQUITY_SNAPSHOT_INTERVAL=1

# =========================
# OPTIMIZER
# =========================
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300
OPTIMIZER_AUTO_APPLY=false
OPTIMIZER_ROLLBACK=true

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO
ENABLE_METRICS=true

# =========================
# SERVER
# =========================
HOST=0.0.0.0
PORT=8080

# =========================
# SOLANA（🔥實盤必要）
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=你的base64私鑰

# =========================
# JUPITER（🔥交易核心）
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

# =========================
# JITO（🔥搶跑核心）
# =========================
USE_JITO=true

JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TX_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions

# tip（越高越快）
JITO_TIP_LAMPORTS=5000
JITO_TIP_STRONG=15000

# 優先費
PRIORITY_FEE_STRONG=120000
PRIORITY_FEE_NORMAL=5000

# =========================
# TOKEN RESOLVER
# =========================
TOKEN_CACHE_TTL=1800
ENABLE_TOKEN_AUTO_RESOLVE=true

# =========================
# FAILSAFE
# =========================
RPC_TIMEOUT=3
RPC_RETRY=2
