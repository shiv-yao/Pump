# =========================
# CORE
# =========================
ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
DEBUG_MODE=false
PRINT_TRADES=true
ENABLE_METRICS=true

# =========================
# PROVIDERS
# =========================
ENABLE_OPENAI=false
OPENAI_API_KEY=

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=

DATABASE_URL=
POLYMARKET_API_KEY=

# =========================
# GATEWAY / EXECUTION
# =========================
TRADING_API_BASE=https://your-gateway-url/api
GATEWAY_TIMEOUT=5
GATEWAY_RETRY=3

ENGINE_LOOP_INTERVAL=0.12
MAX_LATENCY=0.08
MIN_EDGE=0.02
EDGE_STRONG_THRESHOLD=0.05
FILL_PROB_THRESHOLD=0.30

EXECUTION_MODE=adaptive
EXECUTION_RETRY=3
EXECUTION_TIMEOUT=3

# =========================
# 🚀 EXECUTION BOOST (新)
# =========================
EXECUTION_FAST_PATH=true
EXECUTION_PARALLEL_QUOTES=true
EXECUTION_USE_SIM_FALLBACK=true
EXECUTION_FORCE_CHAIN=true

# =========================
# FUND BRAIN
# =========================
DEFAULT_CAPITAL=100

FB_THRESHOLD_MIN=0.55
FB_THRESHOLD_MAX=0.75

FB_RISK_MIN=0.50
FB_RISK_MAX=2.50

FB_BASE_SIZE=0.01
FB_ENABLE_DYNAMIC_SIZING=true
FB_ENABLE_REGIME_FILTER=true
FB_ENABLE_SNIPER_OVERRIDE=true

# =========================
# EARLY ALPHA
# =========================
EARLY_WALLET_MIN=0.60
EARLY_RUG_MAX=0.70
EARLY_ENTRY_FRAC=0.005
EARLY_ADDON_FRAC=0.015
EARLY_MAX_IMPACT=0.12
EARLY_MIN_LIQ=300

# =========================
# WALLET ALPHA
# =========================
WALLET_ALPHA_WINDOW=50
WALLET_DECAY=0.95

WALLET_MIN_CONFIDENCE=0.60
WALLET_CLUSTER_ENABLE=true

WALLET_EARLY_SCORE=0.75
WALLET_STRONG_SCORE=0.85

# =========================
# 🔥 DEV WALLET (Sniper MAX核心)
# =========================
DEV_WALLET_ENABLE=true
DEV_SIGNAL_THRESHOLD=0.80
DEV_WALLET_TRACKING=true

DEV_MAX_POSITION=0.08
DEV_FORCE_ENTRY=true

# =========================
# 🔥 SNIPER MAX
# =========================
SNIPER_ENABLE=true

SNIPER_SCAN_INTERVAL=0.20
SNIPER_MIN_SCORE=0.70
SNIPER_STRONG_SCORE=0.85

SNIPER_BASE_SIZE=0.02
SNIPER_MAX_SIZE=0.06

SNIPER_MAX_POSITIONS=3
SNIPER_REPEAT_BLOCK_SEC=300

SNIPER_FORCE_BUY=true
SNIPER_SKIP_RISK_CHECK=false

# =========================
# ⚡ MEMPOOL (關鍵升級)
# =========================
ENABLE_MEMPOOL=true
MEMPOOL_FAST_MODE=true

MEMPOOL_SCAN_INTERVAL=0.08
MEMPOOL_MIN_SCORE=0.75

MEMPOOL_ENABLE_DECODE=true
MEMPOOL_ENABLE_GNN=false

# =========================
# 🚀 JITO BOOST (最重要)
# =========================
USE_JITO=true

JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TX_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions

JITO_TIP_LAMPORTS=5000
JITO_TIP_STRONG=20000

PRIORITY_FEE_NORMAL=8000
PRIORITY_FEE_STRONG=150000

JITO_ENABLE_BACKRUN=false
JITO_FORCE_BUNDLE=true

# =========================
# PUMP
# =========================
PUMP_ENABLE=true
PUMP_MAX_AGE_SEC=120
PUMP_LIMIT=20

# =========================
# RUG GUARD
# =========================
RUG_SCORE_MAX=0.70
RUG_LIQ_MIN=300

# =========================
# PORTFOLIO / ALLOCATOR
# =========================
REGIME_TREND_THRESHOLD=0.60

ALPHA_ORDERBOOK_WEIGHT=0.40
ALPHA_WALLET_WEIGHT=0.30
ALPHA_EVENT_WEIGHT=0.20
ALPHA_FLOW_WEIGHT=0.10

ALLOCATOR_RISK_FACTOR=1.3
PORTFOLIO_MAX_STRATEGIES=5
PORTFOLIO_REBALANCE_INTERVAL=60

# =========================
# STRATEGY CONTROL
# =========================
STRATEGY_MIN_TRADES=20
STRATEGY_SHUTDOWN_DD=0.20

# =========================
# RISK MANAGEMENT
# =========================
MAX_POSITION_PER_TRADE=0.06
MAX_TOTAL_EXPOSURE=0.30
MAX_DAILY_LOSS=0.15

ENABLE_KILL_SWITCH=true
KILL_SWITCH_DD=0.25

# =========================
# LEDGER
# =========================
LEDGER_ENABLE=true
FEE_RATE=0.0007
EQUITY_SNAPSHOT_INTERVAL=1

# =========================
# OPTIMIZER / EVOLUTION
# =========================
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300
OPTIMIZER_AUTO_APPLY=false
OPTIMIZER_ROLLBACK=true

# =========================
# SOLANA
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=YOUR_BASE64_PRIVATE_KEY

SOLANA_TX_COMMITMENT=confirmed
SOLANA_MAX_RETRY=2

# =========================
# JUPITER
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

JUP_SLIPPAGE_BPS=80
JUP_USE_V2=true
JUP_FORCE_EXECUTE=true

# =========================
# TOKEN RESOLVER
# =========================
TOKEN_CACHE_TTL=1800
ENABLE_TOKEN_AUTO_RESOLVE=true

# =========================
# FAILSAFE
# =========================
RPC_TIMEOUT=3
RPC_RETRY=2

FAILSAFE_ENABLE=true
FAILSAFE_MAX_ERRORS=5
FAILSAFE_COOLDOWN=30
