# =========================
# CORE
# =========================
TRADING_API_BASE=https://your-gateway-url/api
POLYMARKET_API_KEY=

ENABLE_OPENAI=false
OPENAI_API_KEY=
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=

DATABASE_URL=

# =========================
# EXECUTION GATEWAY
# =========================
GATEWAY_TIMEOUT=5
GATEWAY_RETRY=3
GATEWAY_CONCURRENCY=10

# =========================
# EXECUTION ENGINE
# =========================
ENGINE_LOOP_INTERVAL=0.20
MAX_LATENCY=0.10
MIN_EDGE=0.02
FILL_PROB_THRESHOLD=0.30
EDGE_STRONG_THRESHOLD=0.05

EXECUTION_MODE=adaptive
EXECUTION_RETRY=3
EXECUTION_TIMEOUT=3

# 防爆單
MAX_CONCURRENT_ORDERS=3
ORDER_COOLDOWN_SEC=2

# =========================
# FUND BRAIN (PRO++)
# =========================
FB_THRESHOLD_MIN=0.50
FB_THRESHOLD_MAX=0.70

FB_RISK_MIN=0.50
FB_RISK_MAX=2.00

FB_BASE_SIZE=0.01

FB_ENABLE_DYNAMIC_SIZING=true
FB_ENABLE_REGIME_FILTER=true

# =========================
# PORTFOLIO
# =========================
REGIME_TREND_THRESHOLD=0.60

ALPHA_ORDERBOOK_WEIGHT=0.40
ALPHA_WALLET_WEIGHT=0.30
ALPHA_EVENT_WEIGHT=0.20
ALPHA_FLOW_WEIGHT=0.10

ALLOCATOR_RISK_FACTOR=1.0
PORTFOLIO_MAX_STRATEGIES=5
PORTFOLIO_REBALANCE_INTERVAL=60

# =========================
# STRATEGY CONTROL
# =========================
STRATEGY_MIN_TRADES=20
STRATEGY_SHUTDOWN_DD=0.20

# =========================
# RISK MANAGEMENT
# =========================
MAX_POSITION_PER_TRADE=0.05
MAX_TOTAL_EXPOSURE=0.20
MAX_DAILY_LOSS=0.15

ENABLE_KILL_SWITCH=true
KILL_SWITCH_DD=0.25

# 強制冷卻
MAX_CONSEC_LOSS=3
COOLDOWN_AFTER_LOSS=120

# =========================
# WALLET ALPHA
# =========================
WALLET_ALPHA_WINDOW=50
WALLET_DECAY=0.95

WALLET_MIN_CONFIDENCE=0.6
WALLET_CLUSTER_ENABLE=true

# 強化 insider detection
WALLET_EARLY_BOOST=true
WALLET_SMART_MONEY_ONLY=false

# =========================
# SNIPER（🔥核心）
# =========================
SNIPER_SCAN_INTERVAL=0.25
SNIPER_MIN_SCORE=0.7
SNIPER_STRONG_SCORE=0.85

SNIPER_BASE_SIZE=0.02
SNIPER_MAX_SIZE=0.05

SNIPER_MAX_POSITIONS=3
SNIPER_REPEAT_BLOCK_SEC=300

# =========================
# EARLY ENTRY（🔥最關鍵）
# =========================
EARLY_WALLET_MIN=0.6
EARLY_RUG_MAX=0.7
EARLY_ENTRY_FRAC=0.005
EARLY_ADDON_FRAC=0.015
EARLY_MAX_IMPACT=0.15
EARLY_MIN_LIQ=300

EARLY_FORCE_ENTRY=true
EARLY_SOURCE_WINDOW_SEC=120

# =========================
# PUMP.FUN（🔥alpha來源）
# =========================
PUMP_MAX_AGE_SEC=120
PUMP_LIMIT=30
PUMP_ENABLE=true

# =========================
# RUG GUARD
# =========================
RUG_SCORE_MAX=0.7
RUG_LIQ_MIN=300

# =========================
# LEDGER
# =========================
FEE_RATE=0.0007
LEDGER_ENABLE=true
EQUITY_SNAPSHOT_INTERVAL=1

# =========================
# OPTIMIZER
# =========================
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300
OPTIMIZER_AUTO_APPLY=false
OPTIMIZER_ROLLBACK=true

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO
ENABLE_METRICS=true

# =========================
# SERVER
# =========================
HOST=0.0.0.0
PORT=8080

# =========================
# SOLANA（🔥實盤關鍵）
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_RPC_BACKUP=https://rpc.ankr.com/solana
SOLANA_RPC_3=https://solana-mainnet.rpc.extrnode.com

SOLANA_PRIVATE_KEY=你的base64私鑰

# =========================
# JUPITER（🔥交易核心）
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute
JUP_QUOTE_URL=https://quote-api.jup.ag/v6/quote

JUP_SLIPPAGE_BPS=80
JUP_TIMEOUT=3

# =========================
# JITO（🔥搶跑）
# =========================
USE_JITO=true
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TX_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions

JITO_TIP_LAMPORTS=5000
JITO_TIP_STRONG=10000

PRIORITY_FEE_STRONG=120000
PRIORITY_FEE_NORMAL=5000

# =========================
# TOKEN RESOLVER
# =========================
TOKEN_CACHE_TTL=1800
ENABLE_TOKEN_AUTO_RESOLVE=true

# =========================
# FAILSAFE（🔥穩定性）
# =========================
RPC_TIMEOUT=3
RPC_RETRY=3

HTTP_TIMEOUT=5
HTTP_RETRY=3

# 防限流
GLOBAL_RATE_LIMIT=10

# =========================
# SNIPER MAX（🔥最關鍵）
# =========================
SNIPER_MODE=MAX
SNIPER_FRONT_RUN=true

# mempool
ENABLE_MEMPOOL=true
MEMPOOL_FAST_MODE=true

# dev wallet
DEV_WALLET_TRACKING=true
DEV_SIGNAL_THRESHOLD=0.8

# =========================
# JITO 強化
# =========================
JITO_TIP_STRONG=10000
PRIORITY_FEE_STRONG=150000

# =========================
# execution boost
# =========================
EXECUTION_PRIORITY_MODE=aggressive
