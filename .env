# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
BASE_URL=https://pump-production-6637.up.railway.app

# =========================
# SOLANA（主 RPC + WS）
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS=wss://api.mainnet-beta.solana.com

# fallback（防炸）
RPC_FALLBACK_1=https://rpc.ankr.com/solana
RPC_FALLBACK_2=https://solana.public-rpc.com

# 私鑰
SOLANA_PRIVATE_KEY=YOUR_KEY
PRIVATE_KEY=YOUR_KEY

# =========================
# JUPITER（交易）
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute
JUP_QUOTE_URL=https://quote-api.jup.ag/v6/quote

SLIPPAGE_BPS=80
PRIORITY_FEE=5000

# =========================
# JITO（防被夾）
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=2000

# =========================
# TRADING MODE（安全模式）
# =========================
AUTO_TRADING=true
REAL_TRADING=false
MANUAL_CONFIRM=true

TRADING_INTERVAL_SEC=5

# =========================
# RISK CONTROL（🔥核心）
# =========================
MAX_POSITION_PER_TRADE=0.01
MAX_TOTAL_EXPOSURE=0.05
MAX_DAILY_LOSS=0.03
MAX_CONSEC_LOSS=3

# 🔥 防爆單
MAX_TRADES_PER_MIN=3
COOLDOWN_AFTER_TRADE_SEC=10

# =========================
# SNIPER（🔥核心）
# =========================
ENABLE_CHAIN_SNIPER=true
ENABLE_SNIPER=true

SNIPER_SCAN_INTERVAL=2
SNIPER_MIN_SCORE=0.7
SNIPER_MAX_AGE_SEC=120

# =========================
# DEX SNIPER（備用）
# =========================
ENABLE_DEX_SNIPER=true
DEX_SEARCH_QUERY=SOL
DEX_MIN_LIQ_USD=10000
DEX_MIN_VOL_24H=20000

# =========================
# ❌ 關閉 PUMP（避免 530）
# =========================
ENABLE_PUMP_SNIPER=false

# =========================
# LIQUIDITY FILTER
# =========================
EARLY_MIN_LIQ=300

# =========================
# JUPITER QUOTE FILTER（🔥防垃圾幣）
# =========================
ENABLE_JUPITER_QUOTE_CHECK=true
MAX_PRICE_IMPACT=0.15
MIN_OUT_AMOUNT=300

# =========================
# KRONOS（方向濾網）
# =========================
ENABLE_KRONOS=true

# =========================
# MICROSTRUCTURE（深度）
# =========================
ENABLE_MICROSTRUCTURE=true
MAX_ORDERBOOK_SPREAD=0.04
MAX_ORDERBOOK_IMPACT=0.15

# =========================
# MEV GUARD（防夾）
# =========================
ENABLE_MEV_GUARD=true
MEV_RISK_MAX=0.55
MEV_FORCE_JITO_RISK=0.25

# =========================
# ALLOCATOR（資金分配）
# =========================
ENABLE_MULTI_STRATEGY_ALLOCATOR=true
ALLOCATOR_RISK_FACTOR=1.2
PORTFOLIO_MAX_STRATEGIES=5

# =========================
# AUTOML（自動優化）
# =========================
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300

# =========================
# ORCHESTRATOR
# =========================
ORCH_ENABLED=true

# =========================
# DEBUG
# =========================
LOG_LEVEL=INFO

DEX_SCAN_SYMBOLS=SOL,USDC,BONK,JUP,RAY

ENABLE_ONCHAIN_SNIPER=true
MANUAL_CONFIRM=false
REAL_TRADING=false
