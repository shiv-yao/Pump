# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production

# =========================
# SOLANA
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=YOUR_KEY

# =========================
# JUPITER
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

SLIPPAGE_BPS=80
PRIORITY_FEE=5000

# =========================
# JITO
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=2000

# =========================
# FUND BRAIN
# =========================
MIN_SCORE=0.60
MAX_POSITION_SIZE=0.05

# =========================
# RISK
# =========================
MAX_POSITION_PER_TRADE=0.03
MAX_TOTAL_EXPOSURE=0.15
MAX_DAILY_LOSS=0.05

# =========================
# WALLET ALPHA
# =========================
WALLET_MIN_CONFIDENCE=0.6

# =========================
# SNIPER
# =========================
SNIPER_SCAN_INTERVAL=0.3
SNIPER_MIN_SCORE=0.7

# =========================
# AUTOML
# =========================
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300

ENABLE_MICROSTRUCTURE=true
MAX_ORDERBOOK_SPREAD=0.04
MAX_ORDERBOOK_IMPACT=0.15

ENABLE_MEV_GUARD=true
MEV_RISK_MAX=0.55
MEV_FORCE_JITO_RISK=0.25

ENABLE_MULTI_STRATEGY_ALLOCATOR=true
ALLOCATOR_RISK_FACTOR=1.2
PORTFOLIO_MAX_STRATEGIES=5

AUTO_TRADING=true
REAL_TRADING=false
MANUAL_CONFIRM=true
TRADING_INTERVAL_SEC=10

RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC=https://api.mainnet-beta.solana.com

PRIVATE_KEY=YOUR_KEY
SOLANA_PRIVATE_KEY=YOUR_KEY
