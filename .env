# =========================
# CORE
# =========================
TRADING_API_BASE=https://your-gateway-url/api
POLYMARKET_API_KEY=your_api_key_here

ENABLE_OPENAI=false
OPENAI_API_KEY=
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=

DATABASE_URL=

# =========================
# EXECUTION GATEWAY
# =========================
GATEWAY_TIMEOUT=5
GATEWAY_RETRY=2

# =========================
# EXECUTION ENGINE (V8 READY)
# =========================
MAX_LATENCY=0.10
MIN_EDGE=0.02
FILL_PROB_THRESHOLD=0.30
EDGE_STRONG_THRESHOLD=0.05
ENGINE_LOOP_INTERVAL=0.20

# execution 行為控制
EXECUTION_MODE=adaptive
EXECUTION_RETRY=2
EXECUTION_TIMEOUT=3

# =========================
# FUND BRAIN V9
# =========================
FB_THRESHOLD_MIN=0.50
FB_THRESHOLD_MAX=0.70
FB_RISK_MIN=0.50
FB_RISK_MAX=2.00
FB_BASE_SIZE=0.01

# dynamic sizing
FB_ENABLE_DYNAMIC_SIZING=true
FB_ENABLE_REGIME_FILTER=true

# =========================
# PORTFOLIO (V9)
# =========================
REGIME_TREND_THRESHOLD=0.60

ALPHA_ORDERBOOK_WEIGHT=0.40
ALPHA_WALLET_WEIGHT=0.30
ALPHA_EVENT_WEIGHT=0.20
ALPHA_FLOW_WEIGHT=0.10

ALLOCATOR_RISK_FACTOR=1.0
PORTFOLIO_MAX_STRATEGIES=5
PORTFOLIO_REBALANCE_INTERVAL=60

# strategy control
STRATEGY_MIN_TRADES=20
STRATEGY_SHUTDOWN_DD=0.20

# =========================
# RISK MANAGEMENT
# =========================
MAX_POSITION_PER_TRADE=0.05
MAX_TOTAL_EXPOSURE=0.20
MAX_DAILY_LOSS=0.15

# hard kill switch
ENABLE_KILL_SWITCH=true
KILL_SWITCH_DD=0.25

# =========================
# WALLET ALPHA V2
# =========================
WALLET_ALPHA_WINDOW=50
WALLET_DECAY=0.95

# smart money強化
WALLET_MIN_CONFIDENCE=0.6
WALLET_CLUSTER_ENABLE=true

# =========================
# LEDGER V2（🔥新增）
# =========================
FEE_RATE=0.0007
LEDGER_ENABLE=true
EQUITY_SNAPSHOT_INTERVAL=1

# =========================
# OPTIMIZER V2
# =========================
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300
OPTIMIZER_AUTO_APPLY=false
OPTIMIZER_ROLLBACK=true

# =========================
# LOGGING / DEBUG
# =========================
LOG_LEVEL=INFO
ENABLE_METRICS=true

# =========================
# SERVER
# =========================
HOST=0.0.0.0
PORT=8080
