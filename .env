# ================= 核心 =================
REAL_TRADING=true

# ================= 錢包 =================
PRIVATE_KEY_B58=9SHXr194RM5iQri7U7VqFTUTjWwmG78jTfPaEKVmZ1m5SU68ci7mwrhfBCFfShQxijJLgQNFL1KyDipwj7qJ2s4

# ================= RPC（建議用抗限流） =================
SOLANA_RPC_HTTP=https://rpc.ankr.com/solana
SOLANA_RPC_WSS=wss://rpc.ankr.com/solana/ws

# ================= Jupiter =================
JUP_API_KEY=
JUP_BASE_API=https://quote-api.jup.ag

# ================= Jito（強烈建議開） =================
USE_JITO=true
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# ================= 市場數據 =================
BIRDEYE_API_KEY=你的key

# ===== 基本 =====
AMOUNT=1200000

# ===== 倉位 / 風控 =====
MAX_POSITIONS=4
MAX_EXPOSURE=0.8
MAX_POSITION_SIZE=0.12

# ===== TP / SL（meme 要大波動）=====
TAKE_PROFIT=0.08
STOP_LOSS=-0.025
HARD_STOP_LOSS=-0.04
TRAILING_GAP=0.025

MAX_HOLD_SEC=180
FORCE_EXIT_SEC=120

# ===== 交易節奏 =====
LOOP_SLEEP_SEC=1.5
TOKEN_COOLDOWN=8
BLACKLIST_TIME=40
FORCE_TRADE_AFTER=15

# ===== Entry（關鍵🔥）=====
ENTRY_THRESHOLD=0.05
STRICT_A_TIER_THRESHOLD=0.06

# ===== Filter（放鬆🔥）=====
SOFT_DISABLE_FILTER=true
FILTER_SCORE_BYPASS=0.04

# ===== Liquidity（降超多🔥）=====
MIN_LIQUIDITY_TRADE=2000
MIN_LIQUIDITY_OBSERVE=800

# ===== 價格容忍 =====
MAX_PRICE_JUPITER=0.5
MAX_PRICE_FALLBACK=20

# ===== Universe =====
MIN_UNIVERSE=10
BOOT_SYNTHETIC_UNIVERSE=true

# ===== Breakout / Momentum =====
MIN_CONFIRM_MOMENTUM=0.0005
MIN_CONFIRM_BREAKOUT=0.0008
MAX_BREAKOUT_ABS=0.35

# ===== Alpha 權重（偏 meme🔥）=====
ALPHA_BREAKOUT_WEIGHT=0.45
ALPHA_MOMENTUM_WEIGHT=0.30
ALPHA_SMART_WEIGHT=0.10
ALPHA_LIQ_WEIGHT=0.10
ALPHA_WALLET_WEIGHT=0.05

# ===== Strategy Bias =====
SNIPER_MULTIPLIER=1.6
SMART_MULTIPLIER=1.1
MOMENTUM_MULTIPLIER=1.0

# ===== Agent（更激進🔥）=====
AGENT_MIN_TRADES=3
AGENT_LOOKBACK_TRADES=6

AGENT_BULL_WINRATE=0.55
AGENT_BEAR_WINRATE=0.30

AGENT_RISK_MIN=0.6
AGENT_RISK_MAX=1.6

AGENT_AGGRESSIVE_ENTRY=0.045
AGENT_NORMAL_ENTRY=0.05
AGENT_DEFENSIVE_ENTRY=0.065

AGENT_AGGRESSIVE_TP=0.10
AGENT_NORMAL_TP=0.08
AGENT_DEFENSIVE_TP=0.05

AGENT_AGGRESSIVE_SL=-0.03
AGENT_NORMAL_SL=-0.025
AGENT_DEFENSIVE_SL=-0.02

AGENT_FORCE_TRADE_ENABLE=true

# ===== Breathing（降低限制🔥）=====
BREATHING_LOSS_STREAK=3
BREATHING_COOLDOWN_SEC=120
BREATHING_MIN_RISK_MULT=0.6
BREATHING_MAX_RISK_MULT=1.5

# ===== Buy 限制（放寬🔥）=====
MAX_NEW_BUYS_PER_CYCLE=2
MAX_BUYS_PER_10MIN=20
BUY_WINDOW_SEC=600

# ===== Exploration（超重要🔥）=====
EXPLORATION_ENABLE=true
EXPLORATION_MIN_SCORE=0.03
EXPLORATION_SIZE_FRAC=0.08

# ===== 其他 =====
MAX_TOKENS_PER_CYCLE=120
TOP_K_PRESELECT=5
TOP_N_TO_TRADE=2

MIN_OUT_AMOUNT=100
MAX_CAPITAL=50
