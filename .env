# =========================
# 🌍 CORE ENV
# =========================
PORT=8080
ENV=production
LOG_LEVEL=INFO

# =========================
# 🔑 WALLET / SOLANA
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=YOUR_BASE64_PRIVATE_KEY_HERE

# 常用 mint
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGk9n9Hh4v
SOL_MINT=So11111111111111111111111111111111111111112

# =========================
# ⚡ JUPITER (REAL EXECUTION)
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

# Slippage / fee
DEFAULT_SLIPPAGE_BPS=80
PRIORITY_FEE_LAMPORTS=5000

# =========================
# 🚀 JITO (MEV PROTECTION)
# =========================
USE_JITO=true

JITO_BASE_URL=https://mainnet.block-engine.jito.wtf
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TX_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions

# tip（越高越容易成交）
JITO_TIP_LAMPORTS=2000

# =========================
# 🧠 FUND BRAIN / ENGINE
# =========================
ENGINE_LOOP_INTERVAL=0.2
ENGINE_MAX_POSITIONS=5

# entry / alpha threshold
ALPHA_MIN_SCORE=0.5
ALPHA_STRONG_SCORE=0.7

# sizing
MIN_POSITION_SIZE=0.001
MAX_POSITION_PCT=0.05
DEFAULT_CAPITAL=100

# =========================
# 📊 STRATEGY CONTROL
# =========================
STRATEGY_WINDOW=50
STRATEGY_MIN_TRADES=10
STRATEGY_COOLDOWN_SEC=300

# =========================
# 🛑 RISK ENGINE (PRO+)
# =========================
RISK_MAX_DAILY_LOSS=-0.02
RISK_MAX_DRAWDOWN=-0.05
RISK_KILL_SWITCH=true

# exposure
MAX_EXPOSURE=0.5
MAX_POSITION_SIZE=0.15

# =========================
# 🧬 AUTO EVOLUTION
# =========================
ENABLE_AUTO_EVOLUTION=true
EVOLUTION_INTERVAL_SEC=300
EVOLUTION_MIN_TRADES=20

# =========================
# 🔍 TOKEN RESOLVER
# =========================
TOKEN_CACHE_TTL=1800

# =========================
# 🌐 DATA SOURCES
# =========================
DEXSCREENER_API=https://api.dexscreener.com/latest/dex/search
PUMPFUN_API=https://frontend-api.pump.fun/coins/latest
JUP_TOKEN_API=https://token.jup.ag/all

# =========================
# 🤖 PROVIDERS (OPTIONAL)
# =========================
ENABLE_OPENAI=false
OPENAI_API_KEY=

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=

# =========================
# 📡 TRADING API (OPTIONAL 外部)
# =========================
TRADING_API_BASE=

# =========================
# 🧪 DEBUG
# =========================
DEBUG_MODE=false
PRINT_TRADES=true
