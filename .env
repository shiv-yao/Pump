# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
BASE_URL=https://pump-production-6637.up.railway.app
LOG_LEVEL=INFO

# =========================
# SOLANA
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS=wss://api.mainnet-beta.solana.com

# fallback（🔥避免 DNS / 限流炸）
RPC_FALLBACK_1=https://rpc.ankr.com/solana
RPC_FALLBACK_2=https://solana.public-rpc.com

# =========================
# WALLET
# =========================
SOLANA_PRIVATE_KEY=YOUR_KEY
PRIVATE_KEY=YOUR_KEY

# =========================
# JUPITER（🔥修正 DNS 問題）
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

# ❗ 改這個（你原本會炸）
JUP_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUP_QUOTE_URL_BACKUP=https://quote-api.jup.ag/v6/quote

SLIPPAGE_BPS=120
PRIORITY_FEE=8000

# =========================
# JITO（防夾）
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=3000

# =========================
# TRADING MODE（🔥這裡很重要）
# =========================
AUTO_TRADING=true
REAL_TRADING=false        # ✅先用 PAPER 測
MANUAL_CONFIRM=false

TRADING_INTERVAL_SEC=3

# =========================
# SNIPER（🔥核心）
# =========================
ENABLE_ONCHAIN_SNIPER=true
ENABLE_CHAIN_SNIPER=true
ENABLE_SNIPER=true

# ❗關閉干擾來源
ENABLE_DEX_SNIPER=false
ENABLE_PUMP_SNIPER=false

SNIPER_SCAN_INTERVAL=1
SNIPER_MIN_SCORE=0.6
SNIPER_MAX_AGE_SEC=180

# 🔥 延遲進場（避免被夾）
SNIPER_ENTRY_DELAY_SEC=2

# =========================
# 🔥 可交易判斷（最重要）
# =========================
TRADE_READY_RETRIES=8
TRADE_READY_DELAY_SEC=2

# ❗你之前太嚴格 → 會完全不交易
MIN_OUT_AMOUNT=5
MAX_PRICE_IMPACT=0.40

# =========================
# RISK CONTROL
# =========================
MAX_POSITION_PER_TRADE=0.003
MAX_POSITION_SOL=0.003

MAX_TOTAL_EXPOSURE=0.02
MAX_DAILY_LOSS=0.02
MAX_CONSEC_LOSS=3

MAX_TRADES_PER_MIN=2
COOLDOWN_AFTER_TRADE_SEC=12

# =========================
# AUTO SELL（🔥一定要有）
# =========================
TAKE_PROFIT=0.25
STOP_LOSS=-0.10
TRAILING_GAP=0.08
MAX_HOLD_SEC=240

# =========================
# GUARDS
# =========================
ENABLE_JUPITER_QUOTE_CHECK=true

ENABLE_MEV_GUARD=true
MEV_RISK_MAX=0.60
MEV_FORCE_JITO_RISK=0.30

ENABLE_MICROSTRUCTURE=false   # ❗先關掉（太嚴格會卡單）

MAX_ORDERBOOK_SPREAD=0.05
MAX_ORDERBOOK_IMPACT=0.20

MAX_RUG_SCORE=0.85

# =========================
# FUND / AI（先弱化）
# =========================
ORCH_ENABLED=false            # ❗避免干擾下單
ENABLE_KRONOS=false           # ❗先關
ENABLE_KRONOS_FILTER=false

ENABLE_MULTI_STRATEGY_ALLOCATOR=false

OPTIMIZER_ENABLE=false

# =========================
# DEBUG
# =========================
DEX_SCAN_SYMBOLS=SOL,USDC,BONK,JUP,RAY
