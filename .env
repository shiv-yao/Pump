# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
LOG_LEVEL=INFO
BASE_URL=https://pump-production-6637.up.railway.app

# =========================
# TRADING MODE
# =========================
AUTO_TRADING=true
REAL_TRADING=true
MANUAL_CONFIRM=false
ORCH_ENABLED=true
GLOBAL_GUARD_STRICT=false
ENV_STRICT=false

# =========================
# SOLANA RPC
# =========================
SOLANA_RPC=https://rpc.ankr.com/solana
RPC_URL=https://rpc.ankr.com/solana
SOLANA_RPC_FALLBACKS=https://api.mainnet-beta.solana.com,https://solana.public-rpc.com
RPC_FALLBACK_1=https://api.mainnet-beta.solana.com
RPC_FALLBACK_2=https://solana.public-rpc.com
SOLANA_WS=wss://api.mainnet-beta.solana.com
SOLANA_WSS=wss://api.mainnet-beta.solana.com

# =========================
# WALLET
# =========================
WALLET_PUBLIC_KEY=YOUR_KEY
PUBLIC_KEY=YOUR_PUBLIC_KEY
SOLANA_PRIVATE_KEY=YOUR_KEY
PRIVATE_KEY=YOUR_KEY

# =========================
# JUPITER
# =========================
JUP_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUP_QUOTE_URL_BACKUP=https://quote-api.jup.ag/v6/quote
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute
FORCE_JUP_BACKUP=true

SLIPPAGE_BPS=150
PRIORITY_FEE=10000

# =========================
# JITO / MEV
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=5000

ENABLE_MEV_GUARD=true
MEV_RISK_MAX=0.70
MEV_FORCE_JITO_RISK=0.30

# =========================
# SNIPER
# =========================
ENABLE_ONCHAIN_SNIPER=true
ENABLE_SNIPER=false
ENABLE_CHAIN_SNIPER=false
ENABLE_DEX_SNIPER=false
ENABLE_PUMP_SNIPER=false

SNIPER_SCAN_INTERVAL=1
SNIPER_MIN_SCORE=0.4
SNIPER_MAX_SIZE=0.002
SNIPER_MAX_AGE_SEC=240
SNIPER_ENTRY_DELAY_SEC=1

# =========================
# TRADE READY
# =========================
TRADE_READY_RETRIES=4
TRADE_READY_RETRY=4
TRADE_READY_DELAY_SEC=2

# =========================
# RISK CONTROL
# =========================
MAX_POSITION_PER_TRADE=0.002
MAX_POSITION_SOL=0.002
MAX_POSITION_SIZE=0.002
MAX_OPEN_POSITIONS=5
MAX_TOTAL_EXPOSURE=0.015
MAX_DAILY_LOSS=0.02
MAX_CONSEC_LOSS=3

MAX_TRADES_PER_MIN=3
TOKEN_COOLDOWN_SEC=120
COOLDOWN_AFTER_TRADE_SEC=6

MIN_OUT_AMOUNT=1
MAX_PRICE_IMPACT=0.60
MAX_RUG_SCORE=0.95

TOKEN_WHITELIST=
TOKEN_BLACKLIST=

# =========================
# AUTO SELL
# =========================
ENABLE_AUTO_SELL=true
AUTO_SELL_INTERVAL_SEC=5

TAKE_PROFIT=0.25
STOP_LOSS=-0.08
TRAILING_GAP=0.06
MAX_HOLD_SEC=180

# =========================
# ALPHA / FILTERS
# =========================
MIN_SCORE=60
DEV_SIGNAL_THRESHOLD=0.6
EARLY_MIN_LIQ=5000
EARLY_MAX_IMPACT=0.25
RUG_LIQ_MIN=5000
FB_THRESHOLD_MIN=2

ENABLE_JUPITER_QUOTE_CHECK=true
ENABLE_MICROSTRUCTURE=false

# =========================
# KRONOS / FUND AI
# =========================
ENABLE_KRONOS=false
ENABLE_KRONOS_FILTER=false
KRONOS_MIN_SCORE=60
KRONOS_LIQ_NORM=10000
KRONOS_VOL_NORM=100000

ENABLE_MULTI_STRATEGY_ALLOCATOR=false
OPTIMIZER_ENABLE=false
OPTIMIZER_INTERVAL=120

# =========================
# AI PROVIDERS
# =========================
ENABLE_OPENAI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

AGENT_SYSTEM_PROMPT=

# =========================
# EXTERNAL API / DB
# =========================
TRADING_API_BASE=
TRADING_API_KEY=
POLYMARKET_API_KEY=
DATABASE_URL=

# =========================
# SCHEDULER / SCANNER
# =========================
TRADING_INTERVAL_SEC=2
DEX_SCAN_SYMBOLS=SOL,USDC,BONK,JUP,RAY

# =========================
# GATEWAY
# =========================
GATEWAY_TIMEOUT=30
GATEWAY_RETRY=3

# =========================
# CAPITAL TRACKING
# =========================
START_CAPITAL=1000
CURRENT_CAPITAL=1000
