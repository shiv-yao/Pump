# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
BASE_URL=https://pump-production-6637.up.railway.app

# =========================
# SOLANA（主 RPC + WS）
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS=wss://api.mainnet-beta.solana.com

RPC_FALLBACK_1=https://rpc.ankr.com/solana
RPC_FALLBACK_2=https://solana.public-rpc.com

# =========================
# WALLET
# =========================
SOLANA_PRIVATE_KEY=YOUR_KEY
PRIVATE_KEY=YOUR_KEY

# =========================
# JUPITER（交易）
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute
JUP_QUOTE_URL=https://quote-api.jup.ag/v6/quote

SLIPPAGE_BPS=120
PRIORITY_FEE=8000

# =========================
# JITO（防被夾）
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=3000

# =========================
# TRADING MODE
# =========================
AUTO_TRADING=true
REAL_TRADING=false
MANUAL_CONFIRM=false

TRADING_INTERVAL_SEC=3

# =========================
# RISK CONTROL（🔥關鍵）
# =========================
MAX_POSITION_PER_TRADE=0.005
MAX_TOTAL_EXPOSURE=0.03
MAX_DAILY_LOSS=0.02
MAX_CONSEC_LOSS=3

MAX_TRADES_PER_MIN=2
COOLDOWN_AFTER_TRADE_SEC=12

# =========================
# SNIPER（🔥核心）
# =========================
ENABLE_ONCHAIN_SNIPER=true
ENABLE_SNIPER=true

SNIPER_SCAN_INTERVAL=1
SNIPER_MIN_SCORE=0.6
SNIPER_MAX_AGE_SEC=180

# 🔥 延遲進場（關鍵）
SNIPER_ENTRY_DELAY_SEC=2

# =========================
# ❌ 關閉 API scanner
# =========================
ENABLE_DEX_SNIPER=false
ENABLE_PUMP_SNIPER=false

MIN_OUT_AMOUNT=10
MAX_PRICE_IMPACT=0.35

