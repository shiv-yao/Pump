# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
BASE_URL=https://pump-production-6637.up.railway.app
LOG_LEVEL=INFO

# =========================
# SOLANA
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS=wss://api.mainnet-beta.solana.com

RPC_FALLBACK_1=https://rpc.ankr.com/solana
RPC_FALLBACK_2=https://solana.public-rpc.com

# =========================
# WALLET
# =========================
SOLANA_PRIVATE_KEY=YOUR_KEY
PRIVATE_KEY=YOUR_KEY

# =========================
# JUPITER（🔥穩定版）
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

# 🔥 primary + fallback
JUP_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUP_QUOTE_URL_BACKUP=https://quote-api.jup.ag/v6/quote

SLIPPAGE_BPS=150          # 🔥 提高成功率
PRIORITY_FEE=10000        # 🔥 提高打包成功

# =========================
# JITO
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=5000    # 🔥 防被夾更強

# =========================
# TRADING MODE
# =========================
AUTO_TRADING=true
REAL_TRADING=false
MANUAL_CONFIRM=false

TRADING_INTERVAL_SEC=2     # 🔥 更快

# =========================
# SNIPER（🔥核心）
# =========================
ENABLE_ONCHAIN_SNIPER=true
ENABLE_CHAIN_SNIPER=true
ENABLE_SNIPER=true

ENABLE_DEX_SNIPER=false
ENABLE_PUMP_SNIPER=false

SNIPER_SCAN_INTERVAL=1
SNIPER_MIN_SCORE=0.5       # 🔥 降低門檻（避免沒單）
SNIPER_MAX_AGE_SEC=240

SNIPER_ENTRY_DELAY_SEC=1   # 🔥 更快進場

# =========================
# 🔥 可交易判斷（關鍵）
# =========================
TRADE_READY_RETRIES=6      # 🔥 不要太久
TRADE_READY_DELAY_SEC=2

MIN_OUT_AMOUNT=1           # 🔥 幾乎不擋
MAX_PRICE_IMPACT=0.50      # 🔥 放寬（避免全 skip）

# =========================
# RISK CONTROL
# =========================
MAX_POSITION_PER_TRADE=0.002
MAX_POSITION_SOL=0.002

MAX_TOTAL_EXPOSURE=0.015
MAX_DAILY_LOSS=0.02
MAX_CONSEC_LOSS=3

MAX_TRADES_PER_MIN=3
COOLDOWN_AFTER_TRADE_SEC=8

# =========================
# AUTO SELL（🔥重要）
# =========================
TAKE_PROFIT=0.20
STOP_LOSS=-0.08
TRAILING_GAP=0.06
MAX_HOLD_SEC=180

# =========================
# GUARDS（🔥適中）
# =========================
ENABLE_JUPITER_QUOTE_CHECK=true

ENABLE_MEV_GUARD=true
MEV_RISK_MAX=0.65
MEV_FORCE_JITO_RISK=0.30

ENABLE_MICROSTRUCTURE=false

MAX_RUG_SCORE=0.90   # 🔥 放寬（避免過濾掉全部）

# =========================
# FUND / AI（先關）
# =========================
ORCH_ENABLED=false
ENABLE_KRONOS=false
ENABLE_KRONOS_FILTER=false
ENABLE_MULTI_STRATEGY_ALLOCATOR=false
OPTIMIZER_ENABLE=false

# =========================
# DEBUG
# =========================
DEX_SCAN_SYMBOLS=SOL,USDC,BONK,JUP,RAY
