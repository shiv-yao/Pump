# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
BASE_URL=https://pump-production-6637.up.railway.app
LOG_LEVEL=INFO

# =========================
# SOLANA
# =========================
SOLANA_RPC=https://rpc.ankr.com/solana   # 🔥改這個（更穩）
RPC_URL=https://rpc.ankr.com/solana
SOLANA_WS=wss://api.mainnet-beta.solana.com

RPC_FALLBACK_1=https://api.mainnet-beta.solana.com
RPC_FALLBACK_2=https://solana.public-rpc.com

# =========================
# WALLET
# =========================
SOLANA_PRIVATE_KEY=YOUR_KEY
PRIVATE_KEY=YOUR_KEY
WALLET_PUBLIC_KEY=YOUR_PUBLIC_KEY
PUBLIC_KEY=YOUR_PUBLIC_KEY

# =========================
# JUPITER（🔥穩定 + fallback）
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

JUP_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUP_QUOTE_URL_BACKUP=https://quote-api.jup.ag/v6/quote

FORCE_JUP_BACKUP=true   # 🔥新增（你 code 要支援）

SLIPPAGE_BPS=150
PRIORITY_FEE=10000

# =========================
# JITO（防夾）
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=5000

# =========================
# TRADING MODE
# =========================
AUTO_TRADING=false      # ❗關掉舊 runtime
REAL_TRADING=false
MANUAL_CONFIRM=false

TRADING_INTERVAL_SEC=2

# =========================
# 🔥 SNIPER（只留一個）
# =========================
ENABLE_ONCHAIN_SNIPER=true
ENABLE_SNIPER=false         # ❗關掉
ENABLE_CHAIN_SNIPER=false
ENABLE_DEX_SNIPER=false
ENABLE_PUMP_SNIPER=false

ENABLE_AUTO_SELL=true

SNIPER_SCAN_INTERVAL=1
SNIPER_MIN_SCORE=0.4        # 🔥更容易進
SNIPER_MAX_AGE_SEC=240
SNIPER_ENTRY_DELAY_SEC=1

# =========================
# 🔥 TRADE READY（避免卡死）
# =========================
TRADE_READY_RETRIES=4
TRADE_READY_DELAY_SEC=2

MIN_OUT_AMOUNT=1
MAX_PRICE_IMPACT=0.60       # 🔥放寬

# =========================
# RISK CONTROL
# =========================
MAX_POSITION_PER_TRADE=0.002
MAX_POSITION_SOL=0.002

MAX_TOTAL_EXPOSURE=0.015
MAX_DAILY_LOSS=0.02
MAX_CONSEC_LOSS=3

MAX_TRADES_PER_MIN=3
COOLDOWN_AFTER_TRADE_SEC=6  # 🔥更快再進場

# =========================
# AUTO SELL（必開）
# =========================
AUTO_SELL_INTERVAL_SEC=5

TAKE_PROFIT=0.25
STOP_LOSS=-0.08
TRAILING_GAP=0.06
MAX_HOLD_SEC=180

# =========================
# GUARDS（先放寬）
# =========================
ENABLE_JUPITER_QUOTE_CHECK=true

ENABLE_MEV_GUARD=true
MEV_RISK_MAX=0.70
MEV_FORCE_JITO_RISK=0.30

ENABLE_MICROSTRUCTURE=false

MAX_RUG_SCORE=0.95   # 🔥避免全部被擋

# =========================
# FUND / AI（全部關）
# =========================
ORCH_ENABLED=false
ENABLE_KRONOS=false
ENABLE_KRONOS_FILTER=false
ENABLE_MULTI_STRATEGY_ALLOCATOR=false
OPTIMIZER_ENABLE=false

# =========================
# DEBUG
# =========================
DEX_SCAN_SYMBOLS=SOL,USDC,BONK,JUP,RAY
ENV_STRICT=false
