# =========================
# CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
BASE_URL=https://pump-production-6637.up.railway.app
LOG_LEVEL=INFO

# =========================
# SOLANA
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS=wss://api.mainnet-beta.solana.com
RPC_FALLBACK_1=https://rpc.ankr.com/solana
RPC_FALLBACK_2=https://solana.public-rpc.com

# =========================
# WALLET
# =========================
SOLANA_PRIVATE_KEY=YOUR_KEY
PRIVATE_KEY=YOUR_KEY

# =========================
# JUPITER
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute
JUP_QUOTE_URL=https://quote-api.jup.ag/v6/quote

SLIPPAGE_BPS=120
PRIORITY_FEE=8000

# =========================
# JITO
# =========================
USE_JITO=true
JITO_TIP_LAMPORTS=3000

# =========================
# TRADING MODE
# =========================
AUTO_TRADING=true
REAL_TRADING=false
MANUAL_CONFIRM=false
TRADING_INTERVAL_SEC=3

# =========================
# SNIPER
# =========================
ENABLE_ONCHAIN_SNIPER=true
ENABLE_CHAIN_SNIPER=true
ENABLE_SNIPER=true
ENABLE_DEX_SNIPER=false
ENABLE_PUMP_SNIPER=false

SNIPER_SCAN_INTERVAL=1
SNIPER_MIN_SCORE=0.6
SNIPER_MAX_AGE_SEC=180
SNIPER_ENTRY_DELAY_SEC=2

TRADE_READY_RETRIES=8
TRADE_READY_DELAY_SEC=2
MIN_OUT_AMOUNT=10
MAX_PRICE_IMPACT=0.35

# =========================
# RISK CONTROL
# =========================
MAX_POSITION_PER_TRADE=0.005
MAX_POSITION_SOL=0.005
MAX_TOTAL_EXPOSURE=0.03
MAX_DAILY_LOSS=0.02
MAX_CONSEC_LOSS=3
MAX_TRADES_PER_MIN=2
COOLDOWN_AFTER_TRADE_SEC=12

# =========================
# AUTO SELL
# =========================
TAKE_PROFIT=0.30
STOP_LOSS=-0.12
TRAILING_GAP=0.10
MAX_HOLD_SEC=300

# =========================
# GUARDS
# =========================
ENABLE_JUPITER_QUOTE_CHECK=true
ENABLE_MEV_GUARD=true
MEV_RISK_MAX=0.55
MEV_FORCE_JITO_RISK=0.25
ENABLE_MICROSTRUCTURE=true
MAX_ORDERBOOK_SPREAD=0.04
MAX_ORDERBOOK_IMPACT=0.15
MAX_RUG_SCORE=0.80

# =========================
# FUND / ALLOCATOR / OPTIMIZER
# =========================
ORCH_ENABLED=true
ENABLE_KRONOS=true
ENABLE_KRONOS_FILTER=true
ENABLE_MULTI_STRATEGY_ALLOCATOR=true
ALLOCATOR_RISK_FACTOR=1.2
PORTFOLIO_MAX_STRATEGIES=5
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300

# =========================
# OPTIONAL DEBUG
# =========================
DEX_SCAN_SYMBOLS=SOL,USDC,BONK,JUP,RAY
