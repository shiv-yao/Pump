# =========================
# 🌍 CORE
# =========================
PORT=8080
HOST=0.0.0.0
ENV=production
LOG_LEVEL=INFO

# ❗已改：execution 走 Jupiter，不再依賴外部 gateway
TRADING_API_BASE=

# =========================
# 🔑 WALLET / SOLANA
# =========================
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=YOUR_BASE64_PRIVATE_KEY

USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGk9n9Hh4v
SOL_MINT=So11111111111111111111111111111111111111112

# =========================
# ⚡ JUPITER EXECUTION
# =========================
JUP_ORDER_URL=https://api.jup.ag/swap/v2/order
JUP_EXECUTE_URL=https://api.jup.ag/swap/v2/execute

DEFAULT_SLIPPAGE_BPS=80
PRIORITY_FEE_LAMPORTS=5000

# =========================
# 🚀 JITO (MEV PROTECTION)
# =========================
USE_JITO=true

JITO_BASE_URL=https://mainnet.block-engine.jito.wtf
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TX_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions

JITO_TIP_LAMPORTS=2000

# =========================
# 🧠 EXECUTION ENGINE V8
# =========================
MAX_LATENCY=0.10
MIN_EDGE=0.02
FILL_PROB_THRESHOLD=0.30
EDGE_STRONG_THRESHOLD=0.05
ENGINE_LOOP_INTERVAL=0.20

EXECUTION_MODE=adaptive
EXECUTION_RETRY=2
EXECUTION_TIMEOUT=3

# =========================
# 🧠 FUND BRAIN V9
# =========================
FB_THRESHOLD_MIN=0.50
FB_THRESHOLD_MAX=0.70

FB_RISK_MIN=0.50
FB_RISK_MAX=2.00

FB_BASE_SIZE=0.01

FB_ENABLE_DYNAMIC_SIZING=true
FB_ENABLE_REGIME_FILTER=true

# =========================
# 📊 PORTFOLIO
# =========================
REGIME_TREND_THRESHOLD=0.60

ALPHA_ORDERBOOK_WEIGHT=0.40
ALPHA_WALLET_WEIGHT=0.30
ALPHA_EVENT_WEIGHT=0.20
ALPHA_FLOW_WEIGHT=0.10

ALLOCATOR_RISK_FACTOR=1.0

PORTFOLIO_MAX_STRATEGIES=5
PORTFOLIO_REBALANCE_INTERVAL=60

STRATEGY_MIN_TRADES=20
STRATEGY_SHUTDOWN_DD=0.20

# =========================
# 🛑 RISK MANAGEMENT（🔥修正）
# =========================
MAX_POSITION_PER_TRADE=0.03
MAX_TOTAL_EXPOSURE=0.15
MAX_DAILY_LOSS=0.05

ENABLE_KILL_SWITCH=true
KILL_SWITCH_DD=0.15

# =========================
# 🧠 WALLET ALPHA
# =========================
WALLET_ALPHA_WINDOW=50
WALLET_DECAY=0.95

WALLET_MIN_CONFIDENCE=0.6
WALLET_CLUSTER_ENABLE=true

# =========================
# 🔍 TOKEN RESOLVER（🔥補齊）
# =========================
TOKEN_CACHE_TTL=1800

DEXSCREENER_API=https://api.dexscreener.com/latest/dex/search
PUMPFUN_API=https://frontend-api.pump.fun/coins/latest
JUP_TOKEN_API=https://token.jup.ag/all

# =========================
# 📒 LEDGER
# =========================
FEE_RATE=0.0007
LEDGER_ENABLE=true
EQUITY_SNAPSHOT_INTERVAL=1

# =========================
# 🧬 OPTIMIZER
# =========================
OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=300
OPTIMIZER_AUTO_APPLY=false
OPTIMIZER_ROLLBACK=true

# =========================
# 🤖 PROVIDERS（可選）
# =========================
ENABLE_OPENAI=false
OPENAI_API_KEY=

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=

# =========================
# 🧪 DEBUG
# =========================
ENABLE_METRICS=true
DEBUG_MODE=false
PRINT_TRADES=true

# ===== SNIPER =====
SNIPER_SCAN_INTERVAL=0.3
SNIPER_MIN_SCORE=0.7
SNIPER_STRONG_SCORE=0.8

SNIPER_BASE_SIZE=0.02
SNIPER_MAX_SIZE=0.05

USE_JITO=true

OPTIMIZER_ENABLE=true
OPTIMIZER_INTERVAL=600
