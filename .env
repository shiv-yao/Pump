# =========================
# 🔥 CORE API
# =========================

# Polymarket API（⚠️ 必填）
POLYMARKET_API=https://api.polymarket.com
POLYMARKET_API_KEY=your_api_key_here


# =========================
# 🧠 AI PROVIDERS（選用）
# =========================

ENABLE_OPENAI=false
OPENAI_API_KEY=

ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=


# =========================
# 🧩 PLUGIN SYSTEM
# =========================

PLUGINS_DIR=plugins
PLUGIN_REGISTRY_FILE=plugin_registry.json


# =========================
# 🗄️ DATABASE（可選）
# =========================

# PostgreSQL（推薦 production）
DATABASE_URL=

# fallback sqlite（不用填，會自動用）
# plugins.db


# =========================
# ⚡ EXECUTION（V7）
# =========================

MAX_LATENCY=0.1
MIN_EDGE=0.02

# IOC / LIMIT 行為調整
FILL_PROB_THRESHOLD=0.3
EDGE_STRONG_THRESHOLD=0.05


# =========================
# 🧠 FUND BRAIN（V8）
# =========================

FB_THRESHOLD_MIN=0.5
FB_THRESHOLD_MAX=0.7

FB_RISK_MIN=0.5
FB_RISK_MAX=2.0

FB_BASE_SIZE=0.01


# =========================
# 💰 RISK CONTROL
# =========================

MAX_POSITION_PER_TRADE=0.05
MAX_TOTAL_EXPOSURE=0.2
MAX_DAILY_LOSS=0.15


# =========================
# 📊 WALLET ALPHA
# =========================

WALLET_ALPHA_WINDOW=50
WALLET_DECAY=0.95


# =========================
# 🔄 ENGINE LOOP
# =========================

ENGINE_LOOP_INTERVAL=0.2
ENGINE_MARKETS=A1,A2


# =========================
# 🌐 SERVER
# =========================

HOST=0.0.0.0
PORT=8080
