# ================= RPC（建議用抗限流） =================
SOLANA_RPC_HTTP=https://rpc.ankr.com/solana
SOLANA_RPC_WSS=wss://rpc.ankr.com/solana/ws

# ================= Jupiter =================
JUP_API_KEY=
JUP_BASE_API=https://quote-api.jup.ag

# ================= Jito（強烈建議開） =================
USE_JITO=true
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# ================= 市場數據 =================
BIRDEYE_API_KEY=你的key

# ================= 基本交易 =================
AMOUNT=1000000

MAX_POSITIONS=3
MAX_EXPOSURE=0.5
MAX_POSITION_SIZE=0.05
MIN_ORDER_SOL=0.01

# ================= 風控 =================
TAKE_PROFIT=0.02
STOP_LOSS=-0.01
HARD_STOP_LOSS=-0.018
TRAILING_GAP=0.01

MAX_HOLD_SEC=120
FORCE_EXIT_SEC=90

# ================= Token 控制 =================
TOKEN_COOLDOWN=15
BLACKLIST_TIME=60

# ================= Alpha =================
ENTRY_THRESHOLD=0.11
FILTER_SCORE_BYPASS=0.12

# ================= 流動性 =================
MIN_LIQUIDITY_TRADE=20000
MIN_LIQUIDITY_OBSERVE=3000
MIN_OUT_AMOUNT=300

# ================= 價格限制 =================
MAX_PRICE_JUPITER=0.1
MAX_PRICE_FALLBACK=10

# ================= Universe =================
MIN_UNIVERSE=20
BOOT_SYNTHETIC_UNIVERSE=true

# ================= Adaptive =================
ADAPTIVE_THRESHOLD_MIN=0.04
ADAPTIVE_THRESHOLD_MAX=0.10

# ================= 執行控制 =================
TOP_N_TO_TRADE=1
MAX_TOKENS_PER_CYCLE=80
TOP_K_PRESELECT=3

# ================= Mempool =================
MEMPOOL_WSS=wss://rpc.ankr.com/solana/ws

# ================= Agent（Fund Brain） =================
AGENT_UPDATE_SEC=20

AGENT_MIN_TRADES=5
AGENT_LOOKBACK_TRADES=10

AGENT_BULL_WINRATE=0.60
AGENT_BEAR_WINRATE=0.35

AGENT_RISK_MIN=0.45
AGENT_RISK_MAX=1.35

AGENT_DEFENSIVE_ENTRY=0.095
AGENT_NORMAL_ENTRY=0.085
AGENT_AGGRESSIVE_ENTRY=0.078

AGENT_DEFENSIVE_TP=0.018
AGENT_NORMAL_TP=0.022
AGENT_AGGRESSIVE_TP=0.026

AGENT_DEFENSIVE_SL=-0.010
AGENT_NORMAL_SL=-0.012
AGENT_AGGRESSIVE_SL=-0.014

AGENT_KILL_LOSS_STREAK=4
AGENT_KILL_COOLDOWN_SEC=300

AGENT_FORCE_TRADE_ENABLE=true

# ================= Exploration =================
EXPLORATION_ENABLE=true
EXPLORATION_MIN_SCORE=0.05
EXPLORATION_SIZE_FRAC=0.02

# ================= Breathing（風控節奏） =================
BREATHING_LOSS_STREAK=2
BREATHING_COOLDOWN_SEC=180
BREATHING_MIN_RISK_MULT=0.45
BREATHING_MAX_RISK_MULT=1.20

# ================= HTTP =================
HTTP_TIMEOUT=6
